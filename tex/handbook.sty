\RequirePackage{enumitem}

% LaTeX stops nesting a bullet list at four levels; the algorithms of this
% book go deeper (the Shunting-yard rules nest six). enumitem raises the
% limit, and the first four levels keep the labels the class gives them.
\setlistdepth{9}
\renewlist{itemize}{itemize}{9}
\setlist[itemize]{label=\textbullet}
\setlist[itemize,1]{label=\labelitemi}
\setlist[itemize,2]{label=\labelitemii}
\setlist[itemize,3]{label=\labelitemiii}
\setlist[itemize,4]{label=\labelitemiv}

\endinput
